<html>

<head>
<meta charset="utf-8" />
<title>Mapbox Example 12- San Fran Tree</title>

<meta name="viewport" content="initial-scale=1,maximum-scale=1,user-scalable=no">
<link href="https://api.mapbox.com/mapbox-gl-js/v3.10.0/mapbox-gl.css" rel="stylesheet">
<script src="https://api.mapbox.com/mapbox-gl-js/v3.10.0/mapbox-gl.js"></script>

<style>
    body { margin: 0; padding: 0; }
    #map { position: absolute; top: 0; bottom: 0; width: 100%; };
</style>

</head>

<body>
<div id="map"></div>

<script>

    //Put your mapbox access token here
    mapboxgl.accessToken = 'pk.eyJ1IjoidnJvbWFuIiwiYSI6ImNtN3c3NjA0aTAyajEycXE0NWtuN3NxMXIifQ.SXuBxKu9F3yy6SwV4t6w6g';  

        // Load a new map in the 'map' HTML div
        var map = new mapboxgl.Map({
            container: 'map', // container id
            style: 'mapbox://styles/vroman/cm9ezsudv004i01sg740d5ef3', // Put your mapbox style ID here
            center: [-122.420, 37.777], // starting position [lng, lat]
            zoom: 12 // starting zoom
        });

        // When loading the map
        map.on('load', function() {

            // Add a TREE POINT layer to the map 
            map.addLayer({
                'id':'SF_Urban_Tree',
                'type':'circle',
                'source':{
                    type:'vector',
                    url:'mapbox://vroman.1t1tfsk1' // After "mapbox://" paste your Mapbox tileset ID
                },
                'source-layer':'SF_Urban_Tree_Canopy-9czmzi', // name of tilesets
                'layout':{
                    'visibility': 'visible'
                },
                'paint': {
                    'circle-color':'#86b049',
                    'circle-opacity':1,
                    'circle-stroke-width':0.5,
                    'circle-stroke-color':'white',          //points on the graph
                    'circle-stroke-opacity':0.5,
                    'circle-radius':2
                }
            });
            

        })

</script>

</body>
</html>
